?start: expr

?expr: expr "+" term     -> add
     | expr "-" term     -> sub
     | term

?term: term "*" power     -> mul
     | term "/" power     -> div
     | power

?power: atom "^" power   -> exp
      | "-" power        -> neg
      | "+" power        -> pos
      | atom

?atom: NUMBER            -> num
     | sum_call
     | NAME "(" args ")" -> func_call
     | NAME              -> symbol
     | "(" expr ")"
args: expr ("," expr)*

# sum(k=lo:hi, step=s, body)
sum_call: NAME "(" sum_range sum_step? "," expr ")"
sum_range: NAME "=" expr ":" expr
sum_step: "," NAME "=" expr

%import common.CNAME -> NAME  # ("_"|LETTER) ("_"|LETTER|DIGIT)*
%import common.NUMBER         # NUMBER: FLOAT | INT
%import common.SH_COMMENT     # /#[^\n]*/
%ignore SH_COMMENT
%import common.WS_INLINE      # (" "|/\t/)+
%ignore WS_INLINE
%import common.WS             # /[ \t\f\r\n]/+
%ignore WS
