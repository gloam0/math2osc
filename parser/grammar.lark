?start: expr

?expr: expr "+" term   -> add
     | expr "-" term   -> sub
     | term

?term: term "*" power   -> mul
     | term "/" power   -> div
     | power

?power: atom "^" power -> exp
      | "-" power      -> neg
      | "+" power      -> pos
      | atom

?atom: NUMBER          -> num
     | CONSTANT        -> constant
     | "(" expr ")"
     | func_call
     # | sum_call

func_call: FUNC "(" args ")"
args: expr ("," expr)*

# sum(i=lo..hi [step s], body)
# sum_call: "SUM" "(" NAME "=" expr ".." expr step_clause? "," expr ")"
# step_clause: "step" expr

FUNC.10: /(sin|cos|tan|cot|sec|csc|asin|acos|atan|acot|asec|acsc
         |sinh|cosh|tanh|coth|sech|csch|asinh|acosh|atanh
         |square|saw|tri)/x

# pi, tau, e, sample rate, dt (1/sr)
CONSTANT.10: /(pi|tau|e|sr|dt)/x

SUM.10: "sum"

%import common.CNAME -> NAME  # ("_"|LETTER) ("_"|LETTER|DIGIT)*
%import common.NUMBER         # NUMBER: FLOAT | INT
%import common.SH_COMMENT     # /#[^\n]*/
%ignore SH_COMMENT
%import common.WS_INLINE      # (" "|/\t/)+
%ignore WS_INLINE
%import common.WS             # /[ \t\f\r\n]/+
%ignore WS